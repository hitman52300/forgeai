# ---------- LLM (Ollama) ----------
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
# model used by the factory and the generated agents
LLM_MODEL=qwen2.5:3b
# separate model for the LLM judge (reduces self-preference bias)
JUDGE_MODEL=llama3.2:3b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_S=180
LLM_MAX_RETRIES=3
LLM_SEED=42
LLM_NUM_CTX=4096

# ---------- Embeddings / vector store ----------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_DIR=data/chroma

# ---------- Storage backend ----------
# "supabase" or "local" (local JSON files; used for offline tests)
STORAGE_BACKEND=supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
# server-side only. Never expose to the frontend, never commit.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DOCUMENTS_BUCKET=documents
SUPABASE_DELIVERABLES_BUCKET=deliverables

# ---------- Uploads ----------
MAX_UPLOAD_MB=20
ALLOWED_EXTENSIONS=.txt,.pdf,.docx,.csv

# ---------- Budget defaults (per factory run) ----------
BUDGET_MAX_LLM_CALLS=1500
BUDGET_MAX_TOKENS=3000000
BUDGET_MAX_ITERATIONS=3
BUDGET_MAX_SECONDS=10800
BUDGET_MAX_EVAL_CASES=40
QUALITY_TARGET=0.85

# ---------- API ----------
API_BASE_URL=http://127.0.0.1:8000
# demo/operator login used by the Streamlit UI (Supabase Auth user)
FORGEAI_OPERATOR_EMAIL=

# ---------- OpenRouter (online models; set LLM_PROVIDER=openrouter to use) ----------
# With LLM_PROVIDER=openrouter, LLM_MODEL and JUDGE_MODEL are OpenRouter model ids.
# Free models only by default (OPENROUTER_FREE_ONLY=true refuses any id without ':free').
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FREE_ONLY=true
OPENROUTER_AGENT_MODEL=google/gemma-4-31b-it:free
OPENROUTER_JUDGE_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,inclusionai/ling-3.2-flash:free
OPENROUTER_RATE_LIMIT_RETRIES=4
